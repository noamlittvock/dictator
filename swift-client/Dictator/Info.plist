<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.noamlitt.dictator.commands</string>
			<key>CFBundleURLSchemes</key>
			<array><string>dictator</string></array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
		</dict>
	</array>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(DICTATOR_DISPLAY_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>$(DICTATOR_DISPLAY_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://github.com/noamlittvock/dictator/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>$(DICTATOR_SPARKLE_PUBLIC_KEY)</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUEnableSystemProfiling</key>
	<false/>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_dictator-setup._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Find your other Macs on this network so you can connect them for dictation.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Use this Mac’s microphone for dictation. It may appear active while Dictator is open; idle audio is not saved or sent.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Read the current page from your browser to remember where you dictated.</string>
</dict>
</plist>
