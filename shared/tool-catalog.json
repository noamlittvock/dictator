      "id": "claude-code", "name": "Claude Code", "vendor": "Anthropic", "category": "agent", "symbol": "terminal",
      "signatures": { "process_names": ["claude"], "argv_patterns": ["@anthropic-ai/claude-code"], "config_dirs": [".claude"] },
      "connector": {
        "hook_format": "nested-hooks", "hook_config": ".claude/settings.json", "hook_event": "UserPromptSubmit",
        "prompt_field": "prompt", "session_field": "session_id", "cwd_field": "cwd",
        "transcript": { "format": "claude-history", "path": ".claude/history.jsonl" }
      }
    },
